# Ray runtime environment
RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
RAY_DEFAULT_OBJECT_STORE_MEMORY_PROPORTION=0.75

# Ray Dashboard metrics sources
RAY_GRAFANA_HOST=http://localhost:3000
RAY_PROMETHEUS_HOST=http://localhost:9090

# Ollama web search API key
OLLAMA_API_KEY=your_ollama_api_key_here

# Diffusion serving (image generation)
SENTIMENTIZER_SD35_ENABLED=true
SENTIMENTIZER_API_KEYS=sk-your-secret-key
SENTIMENTIZER_FLUX2_KLEIN_ENABLED=0
SENTIMENTIZER_RATE_LIMIT_PER_MIN=60
SENTIMENTIZER_RATE_LIMIT_BURST=10
SENTIMENTIZER_IDEMPOTENCY_TTL_S=600
# SD 3.5 VRAM offload — leave empty for full GPU. Set to "model" for the
# whole-module swap (modest VRAM win) or "sequential" for submodule swap
# (lowest VRAM, slowest).
# SENTIMENTIZER_SD35_CPU_OFFLOAD=sequential
# FLUX.2 Klein 4B — Apache-2.0, step-distilled. Override model_id if you
# need a fork or a different revision. cpu_offload accepts the same values
# as SD35 ("", "model", "sequential").
# SENTIMENTIZER_FLUX2_KLEIN_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# SENTIMENTIZER_FLUX2_KLEIN_CPU_OFFLOAD=model
